# Public values only: EXPO_PUBLIC_* is embedded in the client bundle.
# Copy to .env.local (gitignored). Never put tokens, passwords or client secrets here.
# Explicit app environment: development | test | production (independent of NODE_ENV).
EXPO_PUBLIC_APP_ENV=
# Explicit API execution mode: mock | real. Production permits real only.
EXPO_PUBLIC_API_MODE=
# Absolute API base URL; HTTPS required for test/production. Required when using API config.
EXPO_PUBLIC_API_BASE_URL=
# App return URI, NOT the backend provider callback. Required only for OAuth config.
# Actual values, backend allowlist and end-to-end return verification: SCRUM-129.
EXPO_PUBLIC_OAUTH_REDIRECT_URI=
